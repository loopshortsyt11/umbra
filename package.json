{
  "name": "umbra",
  "productName": "Umbra",
  "version": "1.0.0",
  "description": "Gizlilik odaklı, Chromium tabanlı tarayıcı: Tor sekmesi, AI paneli, izleyici engelleme",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test:arayuz": "electron . --arayuz-testi",
    "test:duman": "electron . --duman-testi"
  },
  "build": {
    "appId": "com.umbra.browser",
    "productName": "Umbra",
    "files": [
      "main.js",
      "tor.js",
      "ai.js",
      "veri.js",
      "turboindir.js",
      "guncelleme.js",
      "arayuz/**",
      "panel/**",
      "ic/**",
      "sekme/**"
    ],
    "afterPack": "build/fuses.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Umbra",
      "artifactName": "Umbra-Kurulum-${version}.exe"
    },
    "extraResources": [
      {
        "from": "tor-paket",
        "to": "tor-paket"
      }
    ],
    "portable": {
      "artifactName": "Umbra-Tasinabilir-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "loopshortsyt11",
      "repo": "umbra",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loopshortsyt11/umbra.git"
  }
}
